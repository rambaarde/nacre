# demo.tape — generated by Vitrine
Output handoff-cli.mp4
Output handoff-cli.gif
Require varve

Set Shell "bash"
Set FontSize 19
Set Width 1100
Set Height 820
Set Theme "rose-pine-dawn"
Set Padding 20
Set TypingSpeed 50ms
Set WindowBar Colorful

Hide
Type "export VARVE_STORE=/tmp/varve-demo/acme-context"
Enter
Type "cd /tmp/varve-demo/atlas-web"
Enter
Type "clear"
Enter
Show

# step 1
Type "# bob. new machine, new session, never spoke to alice."
Sleep 400ms
Enter
Sleep 1600ms

# step 2
Type "varve"
Sleep 400ms
Enter
Wait+Screen /varve-load/
Sleep 3600ms

# step 3
Type "# what has the team already decided here?"
Sleep 400ms
Enter
Sleep 1300ms

# step 4
Type "varve search cache --all"
Sleep 400ms
Enter
Wait+Screen /beacon/
Sleep 4800ms

# step 5
Type "# alice ruled that out on 08-01. bob never had to ask."
Sleep 400ms
Enter
Sleep 2600ms

