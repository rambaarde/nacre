# demo.tape — generated by Vitrine
Output demo-cli.mp4
Output demo-cli.gif
Require varve
Require git

Set Shell "bash"
Set FontSize 20
Set Width 1400
Set Height 700
Set Theme "rose-pine-dawn"
Set Padding 20
Set TypingSpeed 55ms
Set WindowBar Colorful

Hide
Type "export VARVE_STORE=/tmp/varve-demo/acme-context"
Enter
Type "cd /tmp/varve-demo/atlas-web"
Enter
Type "clear"
Enter
Show

# step 1
Type "cat .varve.yml"
Sleep 400ms
Enter
Wait+Screen /memory/
Sleep 2200ms

# step 2
Type "varve"
Sleep 400ms
Enter
Wait+Screen /varve-load/
Sleep 3400ms

# step 3
Type "varve search cache --all"
Sleep 400ms
Enter
Wait+Screen /beacon/
Sleep 4200ms

# step 4
Type "git -C $VARVE_STORE log --oneline"
Sleep 400ms
Enter
Sleep 3200ms

# step 5
Type "varve serve"
Sleep 400ms
Enter
Sleep 5s
Sleep 3800ms

