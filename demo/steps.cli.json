{
  "type": "cli",
  "theme": "rose-pine-dawn",
  "font_size": 20,
  "width": 1400,
  "height": 700,
  "typing_speed_ms": 55,
  "output": {
    "gif": "demo-cli.gif",
    "mp4": "demo-cli.mp4"
  },
  "require": [
    "varve",
    "git"
  ],
  "setup": [
    "export VARVE_STORE=/tmp/varve-demo/acme-context",
    "cd /tmp/varve-demo/atlas-web",
    "clear"
  ],
  "cleanup": [],
  "steps": [
    {
      "cmd": "cat .varve.yml",
      "wait": "memory",
      "pause_ms": 2200
    },
    {
      "cmd": "varve",
      "pause_ms": 3400,
      "wait": "varve-load"
    },
    {
      "cmd": "varve search cache --all",
      "wait": "beacon",
      "pause_ms": 4200
    },
    {
      "cmd": "git -C $VARVE_STORE log --oneline",
      "pause_ms": 3200
    },
    {
      "cmd": "varve serve",
      "wait": "portal on",
      "pause_ms": 3800
    }
  ]
}
