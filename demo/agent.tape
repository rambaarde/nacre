# demo.tape — generated by Vitrine
Output agent.mp4
Output agent.gif
Require claude
Require varve

Set Shell "bash"
Set FontSize 18
Set Width 1200
Set Height 860
Set Theme "rose-pine-dawn"
Set Padding 20
Set TypingSpeed 45ms
Set WindowBar Colorful

Hide
Type "export VARVE_STORE=/tmp/varve-demo/acme-context"
Enter
Type "cd /tmp/varve-demo/atlas-web"
Enter
Type "clear"
Enter
Show

# step 1
Type "# end of a session. you do not write the log — the agent does."
Sleep 400ms
Enter
Sleep 1800ms

# step 2
Type "claude -p --add-dir $VARVE_STORE --permission-mode acceptEdits 'Use varve-publish. We kept the 419 expiry response instead of reverting to 401 — mobile already ships against 419. atlas-api deploys before atlas-web. Write the log, do not push, then reply with one short line.'"
Sleep 400ms
Enter
Sleep 150s

# step 3
Type "varve"
Sleep 400ms
Enter
Wait+Screen /varve-load/
Sleep 3500ms

