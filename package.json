{
  "name": "varve",
  "version": "0.2.0",
  "description": "One git-backed memory store for a whole company. Agents read plain markdown; humans read the same files.",
  "type": "module",
  "bin": {
    "varve": "dist/bin/varve.js",
    "vrv": "dist/bin/varve.js"
  },
  "files": [
    "dist",
    "skills",
    "store-template",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rambaarde/varve.git"
  },
  "keywords": [
    "ai-memory",
    "agent-memory",
    "team-memory",
    "context",
    "claude",
    "markdown",
    "git"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "types": "dist/src/operations.d.ts"
}
